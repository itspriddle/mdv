---
// The wordmark from Branding/wordmark.svg, in the current text color.
interface Props {
    class?: string;
}
const { class: className } = Astro.props;
---

<svg
    viewBox="0 0 440 156"
    fill="none"
    stroke="currentColor"
    stroke-width="14"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class={className}
>
    <circle cx="55" cy="56" r="40"></circle>
    <path d="M15 16V140"></path>
    <path d="M125 56H205A40 40 0 1 0 195.6 81.7"></path>
    <path d="M235 56H315A40 40 0 1 0 305.6 81.7"></path>
    <circle cx="385" cy="56" r="40"></circle>
    <path d="M345 16V140"></path>
    <circle cx="165" cy="37" r="10.5" stroke="none" class="fill-current dark:fill-highlighter"
    ></circle>
    <circle cx="275" cy="37" r="10.5" stroke="none" class="fill-current dark:fill-highlighter"
    ></circle>
</svg>
