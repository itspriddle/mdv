---
// The two e's of the wordmark on their own, in the current text color.
interface Props {
    class?: string;
}
const { class: className } = Astro.props;
---

<svg
    viewBox="0 0 204 94"
    fill="none"
    stroke="currentColor"
    stroke-width="14"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class={className}
>
    <path d="M7 47H87A40 40 0 1 0 77.6 72.7"></path>
    <path d="M117 47H197A40 40 0 1 0 187.6 72.7"></path>
    <circle cx="47" cy="28" r="10.5" stroke="none" class="fill-current dark:fill-highlighter"
    ></circle>
    <circle cx="157" cy="28" r="10.5" stroke="none" class="fill-current dark:fill-highlighter"
    ></circle>
</svg>
