{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "astro sync",
    "dev": "astro dev",
    "build": "astro check --tsconfig tsconfig.app.json && astro build && node scripts/fetch-release.ts dist",
    "preview": "astro build && wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.8",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "astro": "^7.4.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.160.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  }
}
