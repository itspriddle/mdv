#!/usr/bin/env bash
# Prints the Homebrew cask for a release (#84): Packaging/homebrew/peep.rb with its version and
# sha256 filled in, for Casks/peep.rb in itspriddle/homebrew-brews.
#
#   scripts/render-cask 0.1.0 "$(shasum -a 256 build/release/Peep-0.1.0.dmg | cut -d' ' -f1)"
#
# The release workflow runs it and pushes the output to the tap. Exit 64 on bad usage, 65 if
# the template's version or sha256 line isn't found exactly once.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TEMPLATE="$ROOT/Packaging/homebrew/peep.rb"

usage() {
  echo "usage: scripts/render-cask X.Y.Z SHA256" >&2
  exit 64
}

[[ $# -eq 2 ]] || usage
version="$1"
sha256="$2"

if [[ ! "$version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
  echo "error: version must be X.Y.Z (no leading v): $version" >&2
  usage
fi
if [[ ! "$sha256" =~ ^[0-9a-f]{64}$ ]]; then
  echo "error: sha256 must be 64 lowercase hex digits: $sha256" >&2
  usage
fi

for line in '^  version "[^"]*"$' '^  sha256 "[^"]*"$'; do
  if [[ "$(grep -c "$line" "$TEMPLATE")" != 1 ]]; then
    echo "error: expected one line matching '$line' in $TEMPLATE" >&2
    exit 65
  fi
done

# The template's leading comment is for this repository; the tap's copy says where it comes from.
echo "# Generated from Packaging/homebrew/peep.rb in itspriddle/peep by scripts/render-cask."
echo "# Don't edit it here: the next release replaces it."
sed -E \
  -e '1,/^cask /{/^#/d;}' \
  -e "s/^  version \"[^\"]*\"\$/  version \"$version\"/" \
  -e "s/^  sha256 \"[^\"]*\"\$/  sha256 \"$sha256\"/" \
  "$TEMPLATE"
