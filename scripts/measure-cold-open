#!/usr/bin/env bash
# Measures cold open to first paint (#40): builds mdv in Release, then launches it N times with
# each document as an argument and reports the median of each milestone, in milliseconds since
# the kernel started the process. The app reports its own milestones (`LaunchTiming`, enabled by
# MDV_LAUNCH_TIMING); "painted" is two animation frames after the first page load finished.
#
# Usage: scripts/measure-cold-open [-n RUNS] [-s] [-a APP] [-o] [-b MS] FILE...
#   -n RUNS  launches per file (default 10)
#   -s       skip the build and measure the existing Release build
#   -a APP   measure this mdv.app instead (implies -s), e.g. a copy of an older build
#   -o       show the outline sidebar (default: hidden; the reader's own setting is ignored)
#   -b MS    exit 1 if a file's median first paint is over MS (a local regression check)
#   -f       also measure the floor: scripts/cold-open-floor.swift, a bare AppKit app with one
#            WKWebView configured like mdv's, loading the file's `mdv --html` page at launch
#   -c       also time the Launch Services paths from the command that asks for them (#67):
#            Finder's (`open -n -a APP FILE`) and the CLI's (`APP/Contents/Helpers/mdv FILE`),
#            milliseconds from running the command to the first paint ("sinceCommand"); the
#            app reports to a log file (MDV_LAUNCH_TIMING_LOG), and uses the reader's outline
#            setting (Launch Services passes no launch arguments)
#
# The machine's load moves every number: compare builds in one sitting, or interleaved.
# Every launch ignores saved windows (-ApplePersistenceIgnoreState) and the default viewer offer.
# It launches the binary directly (not through Launch Services), so another running mdv doesn't
# matter, but it opens windows: run it while nothing else drives the GUI. With -c, quit any mdv
# at APP's path first (others are fine: both paths then start a new instance).
set -euo pipefail

runs=10
build=1
outline=NO
budget=""
app=""
floor=0
commands=0
while getopts "n:sa:ob:fc" opt; do
  case "$opt" in
    n) runs="$OPTARG" ;;
    s) build=0 ;;
    a) app="$OPTARG" build=0 ;;
    o) outline=YES ;;
    b) budget="$OPTARG" ;;
    f) floor=1 ;;
    c) commands=1 ;;
    *) sed -n '2,25p' "$0"; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
if [ $# -eq 0 ]; then
  sed -n '2,25p' "$0"
  exit 2
fi

root="$(cd "$(dirname "$0")/.." && pwd)"
derived="$root/build/DerivedDataRelease"
app="${app:-$derived/Build/Products/Release/mdv.app}"

if [ "$build" -eq 1 ]; then
  (cd "$root" && xcodegen generate --quiet)
  xcodebuild -project "$root/mdv.xcodeproj" -scheme mdv -configuration Release \
    -destination 'platform=macOS' -derivedDataPath "$derived" CODE_SIGNING_ALLOWED=NO ONLY_ACTIVE_ARCH=YES \
    build -quiet
fi
if [ ! -x "$app/Contents/MacOS/mdv" ]; then
  echo "No Release build at $app; run without -s." >&2
  exit 1
fi

probe="$root/build/ColdOpenFloor.app"
if [ "$floor" -eq 1 ]; then
  mkdir -p "$probe/Contents/MacOS"
  swiftc -O -swift-version 5 "$root/scripts/cold-open-floor.swift" -o "$probe/Contents/MacOS/ColdOpenFloor"
  printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' \
    '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' \
    '<plist version="1.0"><dict>' \
    '<key>CFBundleExecutable</key><string>ColdOpenFloor</string>' \
    '<key>CFBundleIdentifier</key><string>com.itspriddle.mdv.cold-open-floor</string>' \
    '<key>CFBundlePackageType</key><string>APPL</string>' \
    '<key>NSPrincipalClass</key><string>NSApplication</string>' \
    '</dict></plist>' >"$probe/Contents/Info.plist"
  codesign --force --sign - "$probe" 2>/dev/null
fi

# measure LABEL FILE COMMAND...: runs COMMAND $runs times and summarizes its timing reports.
measure() {
  local label="$1" file="$2"
  shift 2
  local results log
  results="$(mktemp)"
  log="$(mktemp)"
  for ((run = 0; run < runs; run++)); do
    # Report and quit; give up on a launch that hasn't painted in 20 s.
    MDV_LAUNCH_TIMING=exit "$@" >/dev/null 2>"$log" &
    local pid=$!
    for _ in $(seq 200); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" || true
      echo "launch timed out" >&2
    fi
    wait "$pid" || true
    sed -n 's/^mdv-launch-timing //p' "$log" >>"$results"
    sleep 1
  done
  printf '%s: %s (%s bytes, %s launches)\n' "$label" "$file" "$(wc -c <"$file" | tr -d ' ')" \
    "$(wc -l <"$results" | tr -d ' ')"
  python3 -I - "$results" "$budget" <<'PY' || status=1
import json, statistics, sys
rows = [json.loads(line) for line in open(sys.argv[1]) if line.strip()]
if not rows:
    sys.exit("no timings reported")
names = sorted({k for r in rows for k in r}, key=lambda k: statistics.median(r[k] for r in rows if k in r))
for name in names:
    values = sorted(r[name] for r in rows if name in r)
    print(f"  {name:22} median {statistics.median(values):7.1f}  min {values[0]:7.1f}  max {values[-1]:7.1f}")
painted = statistics.median(r["painted"] for r in rows)
if sys.argv[2] and painted > float(sys.argv[2]):
    sys.exit(f"  over budget: median first paint {painted:.1f} ms > {sys.argv[2]} ms")
PY
  rm -f "$results" "$log"
}

# measure_command LABEL FILE COMMAND...: runs COMMAND $runs times ({LOG} in it is the log path);
# each launch goes through Launch Services, so the app reports to that log with its process start,
# and the time is from the command's start to the paint.
measure_command() {
  local label="$1" file="$2"
  shift 2
  local log results
  log="$(mktemp)"
  results="$(mktemp)"
  for ((run = 0; run < runs; run++)); do
    : >"$log"
    local start
    start="$(python3 -I -c 'import time; print(time.time() * 1000)')"
    local command=("${@//\{LOG\}/$log}")
    MDV_LAUNCH_TIMING=exit MDV_LAUNCH_TIMING_LOG="$log" "${command[@]}" >/dev/null 2>&1 ||
      echo "$label: command failed" >&2
    for _ in $(seq 200); do
      [ -s "$log" ] && break
      sleep 0.1
    done
    sed -n "s/^mdv-launch-timing //p" "$log" | python3 -I -c '
import json, sys
start = float(sys.argv[1])
for line in sys.stdin:
    row = json.loads(line)
    print(json.dumps({"sinceCommand": row["processStart"] + row["painted"] - start,
                      "painted": row["painted"]}))' "$start" >>"$results"
    sleep 2
  done
  printf '%s: %s (%s launches)\n' "$label" "$file" "$(wc -l <"$results" | tr -d ' ')"
  python3 -I - "$results" <<'PY' || status=1
import json, statistics, sys
rows = [json.loads(line) for line in open(sys.argv[1]) if line.strip()]
if not rows:
    sys.exit("no timings reported")
for name in ["painted", "sinceCommand"]:
    values = sorted(r[name] for r in rows)
    print(f"  {name:22} median {statistics.median(values):7.1f}  min {values[0]:7.1f}  max {values[-1]:7.1f}")
PY
  rm -f "$log" "$results"
}

status=0
for file in "$@"; do
  path="$(cd "$(dirname "$file")" && pwd)/$(basename "$file")"
  measure mdv "$path" "$app/Contents/MacOS/mdv" -ApplePersistenceIgnoreState YES \
    -OutlineVisible "$outline" -DefaultViewerOfferDeclined YES "$path"
  if [ "$floor" -eq 1 ]; then
    html="$(mktemp).html"
    "$app/Contents/Helpers/mdv" --html "$path" >"$html"
    budget="" measure floor "$path" "$probe/Contents/MacOS/ColdOpenFloor" "$html"
    rm -f "$html"
  fi
  if [ "$commands" -eq 1 ]; then
    # `open --env` passes the timing variables; the CLI forwards them to an app it launches.
    measure_command "open -n" "$path" /usr/bin/open -n -a "$app" \
      --env MDV_LAUNCH_TIMING=exit --env "MDV_LAUNCH_TIMING_LOG={LOG}" "$path"
    measure_command "mdv FILE" "$path" "$app/Contents/Helpers/mdv" "$path"
  fi
done
exit "$status"
