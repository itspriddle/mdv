// Shared build settings for all targets and configurations.

// Placeholder identity until the final app name is chosen (see docs/ROADMAP.md).
PRODUCT_BUNDLE_IDENTIFIER_BASE = now.peep.Peep

// Set with scripts/bump-version (also PeepInfo.version; scripts/check-version checks they match).
// CURRENT_PROJECT_VERSION is CFBundleVersion, which Sparkle compares: it only ever increases.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

MACOSX_DEPLOYMENT_TARGET = 15.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// Distributed outside the Mac App Store: hardened runtime, no sandbox.
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
CODE_SIGN_STYLE = Automatic

// Sparkle's EdDSA public key (#81), SUPublicEDKey in Info.plist: the base64 key `generate_keys`
// prints (the private key stays in the maintainer's login keychain and the `release`
// environment's SPARKLE_ED_PRIVATE_KEY). PLACEHOLDER until the maintainer generates the pair;
// Release builds fail while it isn't a real key (project.yml, "Check the Sparkle public key").
SPARKLE_PUBLIC_ED_KEY = PLACEHOLDER_RUN_GENERATE_KEYS

// Optional, gitignored overrides (e.g. DEVELOPMENT_TEAM). See Local.xcconfig.example.
#include? "Local.xcconfig"
